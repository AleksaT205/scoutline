# Kopiraj u .env i popuni. .env se nikad ne commit-uje.
POSTGRES_PASSWORD=promeni-me
LITELLM_MASTER_KEY=sk-promeni-me
API_PORT=3100
API_TOKEN=timska-lozinka   # prvo podešavanje owner naloga + ključ za skripte
SESSION_SECRET=            # opciono: tajna za prijave (inače se izvodi iz API_TOKEN)
CORS_ORIGINS=http://localhost:5173,https://IME.netlify.app

# Besplatni AI ključevi (bar jedan)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Telegram obaveštenja (@BotFather → token; chat id preko @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_SCORE=75      # min. ocena za Telegram
SCORE_BATCH=10           # koliko oglasa AI ocenjuje po minuti (besplatni limiti)

# Lokalni razvoj
DATABASE_URL=postgres://radar:promeni-me@localhost:5432/radar

# Taskovi (GitHub Issues) u dashboard-u — fine-grained token, samo ovaj repo, Issues: read & write
GITHUB_TOKEN=
GITHUB_REPO=AleksaT205/scoutline

# Email-in (Faza 9) — poseban Gmail + App password (docs/EMAIL-IN.md)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# SAM.gov javni API ključ (opciono)
SAM_API_KEY=
