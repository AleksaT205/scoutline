{
  "name": "radar",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @radar/db generate",
    "db:migrate": "pnpm --filter @radar/db migrate"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  }
}
